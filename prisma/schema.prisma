// Real Estate CRM — draft database schema
// PostgreSQL + Prisma 7
// Review and adjust before first migration.

generator client {
  provider     = "prisma-client-js"
  // NestJS uses CommonJS; Prisma 7 defaults to ESM without this.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  OWNER
  MANAGER
  AGENT
  ASSISTANT
}

enum ClientType {
  BUYER
  SELLER
  RENTER
  LANDLORD
  INVESTOR
  BOTH
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  UNDER_OFFER
  SOLD
  RENTED
  OFF_MARKET
}

enum DealStage {
  LEAD
  CONTACTED
  QUALIFIED
  VIEWING
  OFFER
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  VIEWING
  NOTE
  TASK
  FOLLOW_UP
}

enum ActivityStatus {
  OPEN
  DONE
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─────────────────────────────────────────────
// Multi-tenant agency
// ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  email     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  clients    Client[]
  properties Property[]
  deals      Deal[]
  activities Activity[]
  tags       Tag[]
}

// ─────────────────────────────────────────────
// Users (agents / staff)
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  organizationId String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  ownedClients    Client[]    @relation("ClientOwner")
  ownedProperties Property[]  @relation("PropertyOwner")
  ownedDeals      Deal[]      @relation("DealOwner")
  ownedActivities Activity[]  @relation("ActivityOwner")

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// Clients (buyers / sellers / contacts)
// ─────────────────────────────────────────────

model Client {
  id             String     @id @default(cuid())
  organizationId String
  ownerId        String
  type           ClientType? 
  firstName      String
  lastName       String
  gender         Gender?
  email          String?
  phone          String?
  secondaryPhone String?
  company        String?
  address        String?
  city           String?
  notes          String?
  source         String? // referral, website, walk-in, ads, ...
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User         @relation("ClientOwner", fields: [ownerId], references: [id])

  deals      Deal[]
  activities Activity[]
  tags       ClientTag[]

  // buyer preferences (optional)
  budgetMin   Decimal? @db.Decimal(14, 2)
  budgetMax   Decimal? @db.Decimal(14, 2)
  preferredCities String[]
  preferredTypes  PropertyType[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
}

// ─────────────────────────────────────────────
// Properties / listings
// ─────────────────────────────────────────────

model Property {
  id             String         @id @default(cuid())
  organizationId String
  ownerId        String
  title          String
  description    String?
  propertyType   PropertyType
  listingType    ListingType    @default(SALE)
  status         PropertyStatus @default(DRAFT)

  // location
  address     String
  city        String
  district    String?
  country     String  @default("Iran")
  postalCode  String?
  latitude    Float?
  longitude   Float?

  // specs
  price       Decimal  @db.Decimal(14, 2)
  currency    String   @default("IRR")
  bedrooms    Int?
  bathrooms   Int?
  parkingSpots Int?
  areaSqm     Float?
  floor       Int?
  totalFloors Int?
  yearBuilt   Int?
  furnished   Boolean?

  // listing meta
  referenceCode String?
  publishedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User         @relation("PropertyOwner", fields: [ownerId], references: [id])

  media      PropertyMedia[]
  deals      Deal[]
  activities Activity[]
  tags       PropertyTag[]

  @@unique([organizationId, referenceCode])
  @@index([organizationId])
  @@index([ownerId])
  @@index([city, status])
  @@index([listingType, status])
  @@index([price])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  kind       String   @default("IMAGE") // IMAGE | VIDEO | FLOORPLAN | DOC
  caption    String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ─────────────────────────────────────────────
// Deals / pipeline
// ─────────────────────────────────────────────

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  ownerId        String
  clientId       String
  propertyId     String?
  title          String
  stage          DealStage @default(LEAD)
  value          Decimal?  @db.Decimal(14, 2)
  currency       String    @default("IRR")
  probability    Int? // 0–100
  expectedCloseAt DateTime?
  closedAt       DateTime?
  lostReason     String?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User         @relation("DealOwner", fields: [ownerId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])

  activities Activity[]

  @@index([organizationId, stage])
  @@index([ownerId])
  @@index([clientId])
  @@index([propertyId])
}

// ─────────────────────────────────────────────
// Activities (timeline / tasks)
// ─────────────────────────────────────────────

model Activity {
  id             String         @id @default(cuid())
  organizationId String
  ownerId        String
  type           ActivityType
  status         ActivityStatus @default(OPEN)
  subject        String
  body           String?
  dueAt          DateTime?
  completedAt    DateTime?

  clientId   String?
  propertyId String?
  dealId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User         @relation("ActivityOwner", fields: [ownerId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  deal         Deal?        @relation(fields: [dealId], references: [id])

  @@index([organizationId])
  @@index([ownerId, dueAt])
  @@index([clientId])
  @@index([dealId])
  @@index([propertyId])
  @@index([status, dueAt])
}

// ─────────────────────────────────────────────
// Tags (flexible labeling)
// ─────────────────────────────────────────────

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  clients      ClientTag[]
  properties   PropertyTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClientTag {
  clientId String
  tagId    String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

model PropertyTag {
  propertyId String
  tagId      String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([propertyId, tagId])
}
