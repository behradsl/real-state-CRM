// Real Estate CRM — v1 schema
// Focus: organizations, users, addresses, properties (+ deed), parties, contracts

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  OWNER
  MANAGER
  AGENT
  ASSISTANT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum ContractType {
  SALE
  RENT
  GOODWILL
  MUTUAL_RESCISSION
  PRE_SALE
  CONSTRUCTION_JOINT_VENTURE
}

enum PartyType {
  PERSON
  COMPANY
}

enum ContractPartyRole {
  FIRST_PARTY
  SECOND_PARTY
  WITNESS
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─────────────────────────────────────────────
// Shared address (normalized)
// ─────────────────────────────────────────────

model Address {
  id         String   @id @default(uuid())
  province   String
  city       String
  details    String?
  plaque     String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organizations Organization[]
  properties    Property[]
  parties       Party[]

  @@index([province, city])
}

// ─────────────────────────────────────────────
// Organization + users
// ─────────────────────────────────────────────

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  phone         String?
  email         String?
  website       String?
  /// Organization / union license number shown on contract stamps
  licenseNumber String?
  addressId     String?
  address       Address? @relation(fields: [addressId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  properties    Property[]
  parties       Party[]
  contracts     Contract[]
  printLayouts  ContractPrintLayout[]

  @@index([addressId])
}

model User {
  id             String    @id @default(uuid())
  /// Null only for platform ADMIN users
  organizationId String?
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  role           UserRole  @default(AGENT)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id])
  sessions        Session[]
  ownedProperties Property[]    @relation("PropertyOwner")
  createdContracts Contract[]   @relation("ContractCreator")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// Property + deed
// ─────────────────────────────────────────────

model Property {
  id             String       @id @default(uuid())
  organizationId String
  ownerId        String
  title          String
  description    String?
  propertyType   PropertyType
  addressId      String?
  address        Address?     @relation(fields: [addressId], references: [id])

  areaSqm      Float?
  floor        Int?
  totalFloors  Int?
  yearBuilt    Int?
  bedrooms     Int?
  bathrooms    Int?
  parkingSpots Int?
  furnished    Boolean?

  /// Fixed facilities (common to all properties)
  water         Boolean?
  electricity   Boolean?
  gas           Boolean?
  telephone     Boolean?
  parking       Boolean?
  parkingCount  Int?
  storage       Boolean?
  storageCount  Int?
  storageArea   Float?
  elevator      Boolean?
  /// Extra facilities: [{ name: string, kind: string }, ...]
  otherFacilities Json?

  referenceCode String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User         @relation("PropertyOwner", fields: [ownerId], references: [id])
  deedInfo     DeedInfo?
  contracts    Contract[]

  @@unique([organizationId, referenceCode])
  @@index([organizationId])
  @@index([ownerId])
  @@index([addressId])
}

model DeedInfo {
  id                String   @id @default(uuid())
  propertyId        String   @unique
  cadastralNumber   String?
  subParcelNumber   String?
  mainParcelNumber  String?
  plotNumber        String?
  cadastralDistrict String?
  registrationArea  String?
  areaSqm           Float?
  postalCode        String?
  /// Deed booklet / serial number (e.g. for rent forms)
  deedSerialNumber  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Parties (people / companies in contracts)
// ─────────────────────────────────────────────

model Party {
  id                  String    @id @default(uuid())
  organizationId      String
  type                PartyType
  firstName           String?
  lastName            String?
  nationalCode        String?
  economicCode        String?
  companyName         String?
  birthDate           DateTime?
  birthPlace          String?
  identityExportPlace String?
  fatherName          String?
  identityNumber      String?
  gender              Gender?
  phone               String?
  email               String?
  addressId           String?
  address             Address?  @relation(fields: [addressId], references: [id])
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  contractLinks ContractParty[]
  signatures    ContractSignature[]

  @@index([organizationId])
  @@index([nationalCode])
  @@index([economicCode])
  @@index([addressId])
}

// ─────────────────────────────────────────────
// Contracts
// ─────────────────────────────────────────────

model Contract {
  id             String       @id @default(uuid())
  organizationId String
  createdById    String
  propertyId     String
  contractType   ContractType
  contractNumber String
  description    String?

  commissionPercentage            Decimal? @db.Decimal(14, 2)
  commissionAmount                Decimal? @db.Decimal(14, 2)
  taxPercentage                   Decimal? @db.Decimal(14, 2)
  taxAmount                       Decimal? @db.Decimal(14, 2)
  firstPartyCommissionPercentage  Decimal? @db.Decimal(14, 2)
  firstPartyCommissionAmount      Decimal? @db.Decimal(14, 2)
  secondPartyCommissionPercentage Decimal? @db.Decimal(14, 2)
  secondPartyCommissionAmount     Decimal? @db.Decimal(14, 2)

  /// CRM-queryable financial / schedule fields (denormalized from terms forms)
  totalAmount      Decimal?  @db.Decimal(18, 2)
  monthlyAmount    Decimal?  @db.Decimal(18, 2)
  depositAmount    Decimal?  @db.Decimal(18, 2)
  startDate        DateTime?
  endDate          DateTime?
  deliveryDate     DateTime?
  officialDeedDate DateTime?

  /// Structured by frontend (clauses, payment banks, form-only details)
  termsAndConditions Json?

  signedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  createdBy    User                @relation("ContractCreator", fields: [createdById], references: [id])
  property     Property            @relation(fields: [propertyId], references: [id])
  parties      ContractParty[]
  signatures   ContractSignature[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([propertyId])
  @@index([createdById])
}

model ContractParty {
  id         String            @id @default(uuid())
  contractId String
  partyId    String
  role       ContractPartyRole
  createdAt  DateTime          @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  party    Party    @relation(fields: [partyId], references: [id])

  @@unique([contractId, partyId, role])
  @@index([contractId])
  @@index([partyId])
}

// ─────────────────────────────────────────────
// Per-organization contract print field layouts
// ─────────────────────────────────────────────

model ContractPrintLayout {
  id             String       @id @default(uuid())
  organizationId String
  contractType   ContractType
  /// A3 portrait default: 297 × 420 mm
  paperWidthMm   Float        @default(297)
  paperHeightMm  Float        @default(420)
  /// { [fieldKey]: { start: { x, y, page? }, end: { x, y, page? } } } — mm, bottom-left origin
  fields         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, contractType])
  @@index([organizationId])
}

model File {
  id          String   @id @default(uuid())
  name        String
  path        String
  contentType String
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signatures ContractSignature[]
}

model ContractSignature {
  id         String   @id @default(uuid())
  contractId String
  partyId    String
  fileId     String?
  /// Optional FE payload when no file upload yet
  data       Json?
  signedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  party    Party    @relation(fields: [partyId], references: [id])
  file     File?    @relation(fields: [fileId], references: [id])

  @@unique([contractId, partyId])
  @@index([contractId])
  @@index([partyId])
}
