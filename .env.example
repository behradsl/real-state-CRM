# PostgreSQL connection string
# Docker Compose maps container 5432 -> host 5433
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/real_estate_crm?schema=public"

# Frontend origin for cookie-based auth (optional; defaults to reflect request origin)
# CORS_ORIGIN="http://localhost:5173"

# NODE_ENV=development
