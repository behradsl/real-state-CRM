# PostgreSQL connection string
# Local Docker Compose maps container 5432 -> host 15432 (see docker-compose.yml)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/real_estate_crm?schema=public"

# App port
PORT=3001
NODE_ENV=development

# Frontend origin(s) for cookie-based auth (comma-separated)
# Required when NODE_ENV=production. Prefer explicit origins in staging too.
CORS_ORIGIN="http://localhost:3000"

# Set true behind a reverse proxy so rate limits use X-Forwarded-For
# TRUST_PROXY=true

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=10

# Swagger UI at /docs (default: on in non-production; off in production unless true)
# ENABLE_SWAGGER=false

# Platform ADMIN (created by `pnpm prisma:seed`)
# Use a strong unique password (min 12 chars). Never reuse the old example in production.
ADMIN_EMAIL="admin@platform.local"
ADMIN_PASSWORD="change-me-to-a-long-unique-password"
ADMIN_FIRST_NAME="Platform"
ADMIN_LAST_NAME="Admin"
# Set true only when you intentionally want seed to rotate the existing admin password
# ADMIN_RESET_PASSWORD=false
