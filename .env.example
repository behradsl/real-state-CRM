# PostgreSQL connection string
# Docker Compose maps container 5432 -> host 5433
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/real_estate_crm?schema=public"

# Frontend origin(s) for cookie-based auth (comma-separated)
# Required in production. In development, omit to allow any origin.
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=10

# NODE_ENV=development
